      "parameters": {
        "jsCode": "const result = $json.result;\n\n// Remove ```json and ``` if Gemini returned a code block\nconst cleanResult = result\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\n// Convert the string into real JSON\nconst data = JSON.parse(cleanResult);\n\nreturn [\n  {\n    json: {\n      filename: $json.filename,\n      invoice_number: data.invoice_number,\n      customer_name: data.customer_name,\n      date: data.date,\n      product: data.product,\n      quantity: data.quantity,\n      total: data.total\n    }\n  }\n];"
